# Database
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/firstfiddle
# DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/firstfiddle


# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# App settings
APP_NAME="First Fiddle Reputation Platform"
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Scraping throttle (seconds between requests)
SCRAPE_DELAY=2


# NLP Settings
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
USE_GPU=false
